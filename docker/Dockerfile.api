# syntax=docker/dockerfile:1
# Backend image: REST API + /mcp tool server + job workers in ONE process (see docs/team/integration.md).
# Owner: A4.  Build:  docker build -f docker/Dockerfile.api -t mrf-api:local .
# Run with exactly one replica: the job queue lives in-process.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

# Keep this uv version >= the one that wrote uv.lock (`uv --version` on your machine).
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /bin/

WORKDIR /app

# 1) dependencies only - cached until pyproject.toml / uv.lock change
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --extra data --extra azure --extra mlops

# 2) the project. config/ is required: mrf.config locates config/pipeline.yaml from the repo root,
#    so the project must stay an editable install (uv's default) - do not add --no-editable.
COPY README.md openapi.yaml ./
COPY config ./config
COPY templates ./templates
COPY kb ./kb
COPY src ./src
# built-in legacy model packages: sources + parity fixtures (run_parity needs them at runtime)
COPY models ./models
COPY tests/fixtures ./tests/fixtures
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra data --extra azure --extra mlops

# non-root; /data = persistent volume (reports, blobs, mlruns), /state = local disk (SQLite files)
RUN useradd --create-home --uid 10001 app \
    && mkdir -p /data /state \
    && chown app /data /state
USER app

ENV PATH="/app/.venv/bin:$PATH" \
    MRF_DATA_DIR=/data \
    MRF_SQLITE_PATH=/state/mrf.sqlite \
    MRF_CHECKPOINT_PATH=/state/checkpoints.sqlite \
    MLFLOW_TRACKING_URI=/data/mlruns

EXPOSE 8000
CMD ["uvicorn", "mrf.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
