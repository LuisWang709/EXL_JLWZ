# Copy to .env and fill in. Never commit .env. In Azure, values come from Key Vault + managed identity.

# ---- runtime
MRF_ENV=local                      # local | dev | demo
MRF_API_KEY=change-me              # X-API-Key for the demo
MRF_LOG_LEVEL=INFO
MRF_DATA_DIR=./var                 # local artefacts, sqlite, checkpoints

# ---- storage (A1)
MRF_STORAGE_BACKEND=sqlite         # sqlite | cosmos
MRF_SQLITE_PATH=./var/mrf.sqlite
MRF_CHECKPOINT_PATH=./var/checkpoints.sqlite
MRF_COSMOS_ENDPOINT=
MRF_COSMOS_DATABASE=mrf
MRF_BLOB_ACCOUNT_URL=              # empty -> local filesystem under MRF_DATA_DIR/blobs

# ---- job executor (A1)
MRF_WORKER_CONCURRENCY=2

# ---- LLM (A1 wrapper; all agents)
MRF_LLM_PROVIDER=mock              # mock | azure_openai | openai | github_models
MRF_LLM_MODEL=gpt-4o-mini          # deployment name for azure_openai
MRF_LLM_REVIEWER_MODEL=            # optional separate model for A3 LLM reviewer
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=              # local only; cloud uses managed identity
OPENAI_API_KEY=
OPENAI_BASE_URL=                   # e.g. https://models.inference.ai.azure.com for GitHub Models

# ---- MCP tool server (A1 framework)
MRF_MCP_URL=http://localhost:8000/mcp/
MRF_TOOL_TRANSPORT=inprocess       # inprocess | http

# ---- RAG (A3)
MRF_KB_BACKEND=faiss               # faiss | azure_search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=mrf-kb

# ---- MLflow / monitoring (A2/A4)
MLFLOW_TRACKING_URI=./mlruns
APPLICATIONINSIGHTS_CONNECTION_STRING=
