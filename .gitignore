# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tmp/
.coverage
coverage.xml
htmlcov/

# Secrets / local config
.env
.env.*
!.env.example
*.pem
*.key

# Data never goes into git (see docs/data.md). Only README/.gitkeep are tracked.
/raw*.zip
data/*
!data/README.md
!data/.gitkeep
*.csv
*.parquet
*.xlsx
*.xls
*.sas7bdat
*.xpt
*.rds
*.RData
*.rda
*.feather
!tests/fixtures/**
# Explicitly synthetic validation examples (no raw / customer data).
!models/synthetic_validation/**/development.csv
!models/synthetic_validation/**/validation.csv
!models/synthetic_validation/**/upload_together/input_sample.csv
!models/synthetic_validation/**/upload_together/legacy_scores.csv

# Runtime artefacts
var/
*.sqlite
*.sqlite3
*.db
mlruns/
mlartifacts/
outputs/
# Generated download copy; the unpacked suite is versioned under models/synthetic_validation/.
output/test_models/
reports_out/
kb/index/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
